# Byte-compiled / optimized / ambient files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
venv/
ENV/
env/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PRADAN download scripts (may contain session tokens/credentials)
scripts/downloaders/

# Data rules
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

data/extracted/**
!data/extracted/**/
!data/extracted/**/.gitkeep

data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep

data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# Explicitly track manifest and coverage
!data/data_manifest.csv
!data/coverage_daily.csv

# Models
models/**
!models/**/.gitkeep
