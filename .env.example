# SuryaSense Environment Configuration
# Copy this file to .env and adjust variables as necessary.
# NOTE: Never commit .env or secrets to version control.

# Application environment: development | production
APP_ENV=development

# Streamlit port
STREAMLIT_PORT=8501

# NOAA / External feed endpoints (optional)
GOES_LIVE_URL=https://services.swpc.noaa.gov/json/goes/primary/xrays-1-day.json
